# 必填：PostgreSQL 18 连接串（本地开发示例）
DATABASE_URL=postgres://postgres:root@localhost:5432/plm_dev

# 可选：数据目录（默认 data）
# PLM_DATA_DIR=./data
# 可选：HTTP 端口（默认 8080）
# HTTP_PORT=8080
# 可选：上传体积上限字节（默认 209715200 = 200MB）
# PLM_MAX_UPLOAD=209715200

# docker compose 专用
# HTTP_PORT=8080
# POSTGRES_PASSWORD=plmdev
